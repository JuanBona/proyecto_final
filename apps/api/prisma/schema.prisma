generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  passwordHash            String
  role                    String
  currentRefreshTokenHash String?
  tripRequests            TripRequest[]
  approvals               Approval[]
}

model TripRequest {
  id          String    @id @default(cuid())
  travelerId  String
  destination String
  startDate   DateTime
  endDate     DateTime
  reason      String
  budget      Float
  costCenter  String
  // Allowed: "draft" | "pending_approval" | "approved" | "rejected" | "booked"
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  traveler    User      @relation(fields: [travelerId], references: [id])
  approval    Approval?
  booking     Booking?

  @@index([travelerId])
}

model Approval {
  id            String      @id @default(cuid())
  tripRequestId String      @unique
  approverId    String
  // Allowed: "approved" | "rejected"
  decision      String
  comment       String?
  createdAt     DateTime    @default(now())
  tripRequest   TripRequest @relation(fields: [tripRequestId], references: [id])
  approver      User        @relation(fields: [approverId], references: [id])
}

model Booking {
  id             String      @id @default(cuid())
  tripRequestId  String      @unique
  provider       String
  offerId        String
  currency       String
  totalPrice     Float
  snapshot       String
  status         String      @default("booked")
  bookedAt       DateTime    @default(now())
  createdAt      DateTime    @default(now())
  tripRequest    TripRequest @relation(fields: [tripRequestId], references: [id])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       String
  status        String    @default("pending")
  attempts      Int       @default(0)
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}
