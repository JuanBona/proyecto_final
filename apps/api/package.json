  "main": "dist/src/main",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node .",
    "dev": "PORT=${API_PORT:-3001} npm run start:dev",
    "test": "jest --passWithNoTests",
    "test:e2e": "DATABASE_URL=file:./dev.db prisma migrate deploy --schema ./prisma/schema.prisma && jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma"
  },
